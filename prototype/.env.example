HOST=127.0.0.1
SVC_01_PORT=3001
SVC_02_PORT=3002
SVC_03_PORT=3003
SVC_04_PORT=3004
SVC_05_PORT=3005
SVC_06_PORT=3006
SVC_07_PORT=3007
SVC_08_PORT=3008

# Host ports published by the Compose stack on loopback.
LOCAL_POSTGRES_PORT=5432
LOCAL_DYNAMODB_PORT=8000
LOCAL_REDIS_PORT=6379
LOCAL_ELASTICMQ_PORT=9324
SQS_ENDPOINT=http://127.0.0.1:9324

# Local-only container names and disposable credentials.
LOCAL_POSTGRES_CONTAINER=d4-postgres
LOCAL_DYNAMODB_CONTAINER=d4-dynamodb
SVC_02_DYNAMODB_ENDPOINT=http://127.0.0.1:8000
SVC_08_DYNAMODB_ENDPOINT=http://127.0.0.1:8000
LOCAL_REDIS_CONTAINER=d4-redis
LOCAL_POSTGRES_PASSWORD=local-postgres-only
LOCAL_SVC_01_PASSWORD=local-svc01-only
LOCAL_SVC_05_PASSWORD=local-svc05-only
LOCAL_SVC_06_PASSWORD=local-svc06-only
LOCAL_REDIS_PASSWORD=local-redis-only
